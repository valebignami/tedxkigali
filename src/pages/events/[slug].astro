---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '~/layouts/BaseLayout.astro';
import EventJsonLd from '~/components/EventJsonLd.astro';
import VideoJsonLd from '~/components/VideoJsonLd.astro';
import TalkCard from '~/components/TalkCard.astro';
import { eventEnd, eventState, isBookable, ticketStatusLine } from '~/lib/events';
import { eventMapUrl } from '~/lib/maps';
import { resolveUploadedImage } from '~/lib/images';
import { canonicalUrl } from '~/lib/seo';
import { formatEventDate } from '~/lib/dates';

export async function getStaticPaths() {
  const events = await getCollection('events', ({ data }) => !data.draft);
  return events.map((event) => ({ params: { slug: event.id }, props: { event } }));
}

const { event } = Astro.props;
const data = event.data;
const ticketStatus = data.ticketStatus;

const now = new Date();
const state = eventState(data.startDate, data.endDate, now);
const bookable = isBookable(state, ticketStatus) && !!data.bookingUrl;
const image = data.image ? resolveUploadedImage(data.image) : null;

// Absolute url, required by social networks for the preview image.
const ogImage = image && Astro.site ? new URL(image.src, Astro.site).toString() : undefined;

const dateLabel = formatEventDate(data.startDate);
const venueLabel = `${data.venue}${data.address ? ` — ${data.address}` : ''}`;
const mapUrl = eventMapUrl(data);
// aria-label replaces the link's text when the accessible name is computed, so
// it has to start from venueLabel verbatim: WCAG 2.5.3 requires the accessible
// name to contain the visible one, or speech input cannot activate the link.
const mapAriaLabel = `${venueLabel} — open in Google Maps`;

const { Content } = await render(event);

const talks = (await getCollection('talks', ({ data: talk }) => !talk.draft && talk.edition === event.id)).sort(
  (a, b) => a.data.title.localeCompare(b.data.title),
);

// The organiser is TEDxKigali itself, not this page: schema.org expects an
// Organization.url that identifies the organisation.
const organiserUrl = Astro.site?.toString() ?? canonicalUrl(Astro.url.pathname, Astro.site);
---

<BaseLayout title={data.title} description={data.summary} image={ogImage}>
  <EventJsonLd slot="head" event={event} state={state} organiserUrl={organiserUrl} />
  <VideoJsonLd slot="head" talks={talks} />

  <!-- Same DOM contract as EventCard: src/scripts/event-status.ts re-checks
       every [data-event] element against the visitor's clock, so this page
       withdraws the booking button and corrects the ticket line by itself on a
       build made before the event. -->
  <article
    class="mx-auto max-w-4xl px-4 py-16"
    data-event
    data-event-state={state}
    data-event-start={data.startDate.toISOString()}
    data-event-end={eventEnd(data.startDate, data.endDate).toISOString()}
    data-ticket-status={ticketStatus}
  >
    {data.theme && <p class="text-sm font-bold uppercase tracking-widest text-muted">{data.theme}</p>}
    <h1 class="mt-2 text-4xl font-black uppercase leading-tight md:text-6xl">{data.title}</h1>

    <p class="mt-6 text-lg">
      <time datetime={data.startDate.toISOString()}>{dateLabel}</time>
    </p>
    <p class="text-lg text-muted">
      <a
        class="underline hover:no-underline"
        href={mapUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={mapAriaLabel}
      >
        {venueLabel}
      </a>
    </p>

    {image && (
      <Image
        src={image}
        alt={data.imageAlt ?? ''}
        widths={[600, 1000, 1600]}
        sizes="(min-width: 1024px) 900px, 100vw"
        class="mt-8 w-full rounded-lg object-cover"
      />
    )}

    <div class="mt-8 rounded-lg border border-line bg-surface p-6">
      <p data-ticket-status-label class="text-sm font-semibold uppercase tracking-wide">
        {ticketStatusLine(state, ticketStatus)}
      </p>
      {bookable && (
        <>
          <a
            data-booking
            href={data.bookingUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-block rounded bg-ted-red px-6 py-3 font-bold uppercase tracking-wide text-ink hover:bg-ted-red/90"
          >
            {data.bookingLabel}
          </a>
          <p data-booking-note class="mt-3 text-xs text-muted">
            Booking is handled on an external ticketing website.
          </p>
        </>
      )}
    </div>

    <div class="prose prose-invert mt-10 max-w-none">
      <Content />
    </div>

    {data.schedule.length > 0 && (
      <section class="mt-16">
        <h2 class="text-2xl font-bold uppercase tracking-wide">Programme</h2>
        <ol class="mt-6 space-y-4">
          {data.schedule.map((entry) => (
            <li class="rounded-lg border border-line bg-surface p-4 sm:flex sm:gap-6">
              {/* Rendered even when there is no time, because from sm: up this
                  is the flex item that holds the time column open: a break row
                  without it would start 152px left of every other row. Left
                  empty it has nothing to announce and no line box, so it costs
                  a phone reader neither space nor a stop in the reading order. */}
              <p class="text-sm font-semibold uppercase tracking-wide text-muted sm:w-32 sm:flex-none sm:text-right">{entry.time}</p>
              {/* On a phone the gap separates the time from the title, so a row
                  with no time does not need it. */}
              <div class:list={['sm:mt-0', entry.time && 'mt-1']}>
                <p>
                  <span class="font-bold">{entry.title}</span>
                  {entry.speaker && <span class="text-muted"> — {entry.speaker}</span>}
                </p>
                {entry.note && <p class="mt-1 text-sm text-muted">{entry.note}</p>}
              </div>
            </li>
          ))}
        </ol>
      </section>
    )}

    {talks.length > 0 && (
      <section class="mt-16">
        <h2 class="text-2xl font-bold uppercase tracking-wide">Talks from this edition</h2>
        <div class="mt-6 grid gap-6 sm:grid-cols-2">
          {talks.map((talk) => <TalkCard talk={talk} editionTitle={data.title} />)}
        </div>
      </section>
    )}
  </article>

  <script>
    import '~/scripts/event-status.ts';
  </script>
</BaseLayout>
