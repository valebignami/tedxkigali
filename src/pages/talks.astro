---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import FilterButton from '~/components/FilterButton.astro';
import TalkCard from '~/components/TalkCard.astro';
import VideoJsonLd from '~/components/VideoJsonLd.astro';
import { resolveEditions } from '~/lib/editions';
import {
  DEFAULT_PROGRAMME,
  PROGRAMME_NAMES,
  editionLabelUnder,
  programmesInOrder,
} from '~/lib/programmes';
import { referencedId } from '~/lib/stored-reference';

const talks = (await getCollection('talks', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

// Drafts are left out on purpose: an event hidden with "Hide from the website"
// has no page, so resolveEditions must treat it as missing and stop the build
// rather than let a talk advertise an edition nobody can open.
const events = await getCollection('events', ({ data }) => !data.draft);

// The hidden ones as well, for the message only. A talk whose edition is merely
// hidden can then be told which event it means, by the title the volunteer gave
// it, instead of by the id stored in its file.
const everyEditionTitle = new Map(
  (await getCollection('events')).map((event) => [event.id, event.data.title]),
);

const { titleById, used: editions } = resolveEditions(
  talks.map((talk) => ({ title: talk.data.title, editionId: talk.data.edition })),
  events.map((event) => ({ id: event.id, title: event.data.title, startDate: event.data.startDate })),
  everyEditionTitle,
);

// titleById is keyed by edition id, and a talk stores a file name, so the
// stored value is normalised before it is used to look anything up — the same
// step resolveEditions has already taken to decide the build may go on.
const editionTitleOf = (stored: string | undefined) => {
  const id = referencedId(stored);
  return id ? titleById.get(id) : undefined;
};

// A talk has no programme of its own: it takes the one its edition carries.
// Every id in the resolved editions came out of the events above, so the
// fallback is unreachable today and is here so a later caller cannot make this
// throw on an id it did not expect.
const programmeOfEdition = new Map(events.map((event) => [event.id, event.data.programme]));
const programmeOf = (editionId: string) => programmeOfEdition.get(editionId) ?? DEFAULT_PROGRAMME;
const programmeOfTalk = (stored: string | undefined) => {
  const id = referencedId(stored);
  return id && programmeOfEdition.has(id) ? programmeOfEdition.get(id)! : undefined;
};

// The programmes come first and the editions of one appear underneath it, so
// the row of pills is two lines high whatever happens later: an organisation
// with thirty editions gets the same five buttons as one with six. Listing
// every edition at the top level was the first design, and at eleven editions
// its filter bar was taller than the first row of cards.
//
// Only the programmes with an edition that has talks: `editions` is
// resolveEditions' `used`, so an edition nobody has filmed yet — the next one,
// usually — has no button here and no programme of its own to open.
const programmeGroups = programmesInOrder(editions.map((edition) => programmeOf(edition.id))).map(
  (programme) => ({
    programme,
    name: PROGRAMME_NAMES[programme],
    // The word the mark does not already say — "Women", not "TEDxKigali
    // Women" — because "TEDxKigali" is the name at the top of every page. The
    // full name is the button's accessible name.
    short: editionLabelUnder(PROGRAMME_NAMES[programme], DEFAULT_PROGRAMME),
    editions: editions.filter((edition) => programmeOf(edition.id) === programme),
  }),
);

// With one programme there is nothing to sort into, and a single button reading
// "TEDxKigali" would filter to everything. The editions go back to being the
// top row, which is what this page was before programmes existed.
const grouped = programmeGroups.length > 1;

const tags = [...new Set(talks.flatMap((talk) => talk.data.tags))].sort();
---

<BaseLayout
  title="Talks"
  description="Every TEDxKigali talk, ready to watch without leaving the site."
>
  <VideoJsonLd slot="head" talks={talks} />

  <section class="mx-auto max-w-6xl px-4 py-16">
    <h1 class="text-4xl font-black uppercase md:text-6xl">Talks</h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">
      Ideas from the TEDxKigali stage. Press play — the talk opens right here.
    </p>

    {editions.length > 0 && (
      <div
        id="talk-filters"
        class="mt-10 flex flex-wrap gap-2"
        role="group"
        aria-label="Filter talks by programme, edition or topic"
      >
        <FilterButton kind="all" value="all" label="All" pressed />

        {grouped ? (
          <>
            {programmeGroups.map((group) => (
              <FilterButton
                kind="programme"
                value={group.programme}
                label={group.short}
                accessibleName={group.short === group.name ? undefined : group.name}
              />
            ))}

            {/* One row per programme, all of them built and all but one hidden.
                Built here rather than assembled by the script: the markup is
                then the same thing the page was tested with, and the row that
                opens has nothing to construct first. */}
            {programmeGroups.map((group) => (
              <div
                class="mt-1 flex w-full flex-wrap gap-2 rounded-lg border border-dashed border-line bg-bg p-3"
                data-editions-for={group.programme}
                role="group"
                aria-label={`Editions of ${group.name}`}
                hidden
              >
                {group.editions.map((edition) => (
                  <FilterButton
                    kind="edition"
                    value={edition.id}
                    label={editionLabelUnder(edition.title, group.programme)}
                    accessibleName={edition.title}
                  />
                ))}
              </div>
            ))}
          </>
        ) : (
          editions.map((edition) => (
            <FilterButton kind="edition" value={edition.id} label={edition.title} />
          ))
        )}

        {/* Labelled whether or not the pills above are split by programme.
            Once they are, an unlabelled row under the programme buttons reads
            as more of them; and even alone, nothing on the page said what the
            small pills were. */}
        {tags.length > 0 && (
          <div class="mt-3 flex w-full flex-wrap gap-2" role="group" aria-labelledby="talk-filters-topics">
            <p id="talk-filters-topics" class="w-full text-xs font-bold uppercase tracking-widest text-muted">
              Topics
            </p>
            {tags.map((tag) => (
              <FilterButton kind="tag" value={tag} label={tag} />
            ))}
          </div>
        )}
      </div>
    )}

    {talks.length === 0 ? (
      <p class="mt-12 text-muted">No talks published yet. Come back after the next event.</p>
    ) : (
      <>
        <div id="talks-grid" class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {talks.map((talk) => (
            <TalkCard
              talk={talk}
              editionTitle={editionTitleOf(talk.data.edition)}
              programme={programmeOfTalk(talk.data.edition)}
            />
          ))}
        </div>
        <p id="talks-empty" hidden class="mt-10 text-muted">No talks match this filter yet.</p>
      </>
    )}
  </section>

  <!-- Astro bundles this script and injects it as a deferred module, so it
       always runs after the DOM is parsed, wherever it sits in the file. -->
  <script>
    import '~/scripts/talk-filters.ts';
  </script>
</BaseLayout>
