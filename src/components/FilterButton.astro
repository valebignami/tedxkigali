---
// One filter pill on the talks page. Extracted when the pills were reorganised
// by programme: several branches render the same button, and a second copy of
// these class lists is exactly the kind of thing that drifts — a pressed colour
// changed in one place and not the other would look like a bug in the filter
// rather than in the stylesheet.
interface Props {
  /** Read back by talk-filters.ts to decide what this button matches on. */
  kind: 'all' | 'programme' | 'edition' | 'tag';
  value: string;
  label: string;
  /**
   * The full name, when `label` is a shortened form of it — an edition pill
   * reading "2025 — In the Room" under a programme button reading "Women".
   * It becomes the button's accessible name, and it has to contain the visible
   * label word for word: WCAG 2.5.3 asks that somebody saying what they can see
   * be understood by the software listening. Leave it out when the label is
   * already the whole name.
   */
  accessibleName?: string;
  /** Only the "All" button starts pressed; the script moves it from there. */
  pressed?: boolean;
}

const { kind, value, label, accessibleName, pressed = false } = Astro.props;

// A programme button does two things at once: it filters, and it opens the row
// of that programme's editions. Both are announced — aria-pressed for the
// filter, aria-expanded for the row — because a visitor who cannot see the row
// appear has nothing else to tell them a second set of buttons just arrived.
// The script writes 'true' here when the row opens; this is the shut state.
const expanded = kind === 'programme' ? 'false' : undefined;

// Tags are the smaller, secondary row and take the sun colour when pressed.
// Everything else is one set of pills and shares a shape on purpose.
const shape =
  kind === 'tag'
    ? 'rounded-full border border-line px-3 py-1 text-xs font-semibold uppercase tracking-wide text-muted aria-pressed:border-kigali-sun aria-pressed:text-ink'
    : 'rounded-full border border-line px-4 py-2 text-sm font-semibold uppercase tracking-wide text-muted aria-expanded:border-ted-red/50 aria-expanded:text-ink aria-pressed:border-ted-red aria-pressed:text-ink';

// Written out rather than left as a boolean: aria-pressed is an enumerated
// attribute, not a boolean one, so the string is what belongs in the markup and
// talk-filters.ts writes the same two strings back when the choice moves.
const state: 'true' | 'false' = pressed ? 'true' : 'false';
---

<button
  type="button"
  data-filter-kind={kind}
  data-filter-value={value}
  aria-pressed={state}
  aria-expanded={expanded}
  aria-label={accessibleName}
  class={shape}
>
  {label}
</button>
