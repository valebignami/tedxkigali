---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import SpeakerCard from '~/components/SpeakerCard.astro';
import { compareOrder } from '~/lib/order';

const speakers = (await getCollection('speakers', ({ data }) => !data.draft)).sort((a, b) => {
  const byOrder = compareOrder(a.data.order, b.data.order);
  return byOrder !== 0 ? byOrder : a.data.name.localeCompare(b.data.name);
});

// getEntry resolves hidden entries as happily as published ones, while the
// pages that render them exclude drafts. Linking one straight from here would
// point at a page the build never produced, which is exactly what the "Hide
// from the website" toggle is meant to be safe to use.
const published = <T extends { data: { draft: boolean } }>(entry: T | undefined): T | undefined =>
  entry && !entry.data.draft ? entry : undefined;

const rendered = await Promise.all(
  speakers.map(async (speaker) => {
    const talk = published(speaker.data.talk ? await getEntry(speaker.data.talk) : undefined);
    const { Content } = await render(speaker);
    // The talk card on /talks is the only thing on the site that addresses a
    // single talk, so that is where "Watch the talk" goes. Without a published
    // talk there is nothing to point at but the archive.
    return { speaker, Content, talkHref: talk ? `/talks#${talk.id}` : '/talks' };
  }),
);
---

<BaseLayout title="Speakers" description="The people who have taken the TEDxKigali stage.">
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h1 class="text-4xl font-black uppercase md:text-6xl">Speakers</h1>

    {rendered.length === 0 ? (
      <p class="mt-8 text-muted">Speaker profiles are on their way.</p>
    ) : (
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {rendered.map(({ speaker, Content, talkHref }) => (
          <SpeakerCard speaker={speaker} talkHref={talkHref}>
            <Content />
          </SpeakerCard>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
