---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { parseYouTubeId, youtubeThumbnails } from '~/lib/youtube';
import { resolveUploadedImage } from '~/lib/images';

interface Props {
  talk: CollectionEntry<'talks'>;
  editionTitle?: string;
}

const { talk, editionTitle } = Astro.props;
const { title, speaker, youtubeUrl, thumbnail, thumbnailAlt, summary, date, tags } = talk.data;

// The schema already guarantees this parses; the guard keeps TypeScript honest.
const videoId = parseYouTubeId(youtubeUrl);
if (!videoId) throw new Error(`Talk "${talk.id}" has an unusable YouTube link.`);

const thumbs = youtubeThumbnails(videoId);
const uploaded = thumbnail ? resolveUploadedImage(thumbnail) : null;
const year = date.getUTCFullYear();
---

<!-- The id makes a single talk addressable: /talks#<id> is the only link on
     the site that reaches one talk, and scroll-mt keeps it clear of the
     sticky header when a visitor arrives on the fragment. -->
<article
  id={talk.id}
  class="group flex scroll-mt-24 flex-col overflow-hidden rounded-lg border border-line bg-surface"
  data-talk
  data-edition={talk.data.edition ?? ''}
  data-tags={tags.join('|')}
>
  <button
    type="button"
    class="relative block aspect-video w-full overflow-hidden bg-black"
    data-youtube-id={videoId}
    data-video-title={`${title} — ${speaker}`}
  >
    <!-- sizes is the width of one card, and a card is one of three columns from
         1024px up, one of two from 640px, and the full width below that. The
         card on an event page is a little wider than 400px at desktop sizes;
         declaring the narrower of the two is the safe direction here, because
         the only thing above 400 CSS px in the set is the 1280px still.

         The YouTube branch below carries two sources, for two different reasons.

         srcset does not spare a modern phone the large still, and never could:
         at 390 CSS px on a 2× screen the browser needs 780px, and the only
         still YouTube publishes at or above that is maxresdefault. What it does
         is give every 1× display the 480px one instead — an ordinary desktop
         monitor, where the card is 400 CSS px, and the older and cheaper phones
         that are still on dpr 1. The rule for this set is simply that 1× takes
         hqdefault and 2× takes maxresdefault. That is worth one attribute, so
         the set stays; there is no third rung that would change any of it.

         The two stills are not the same shape: hqdefault is 480x360, 4:3, with
         black bars top and bottom, against the 16:9 width/height declared here.
         object-cover crops exactly the bars away, so the card looks right
         either way, but nothing here should start relying on the intrinsic
         ratio of what was downloaded.

         onerror covers the videos YouTube never generated a maxres still for,
         and clears srcset first, or the browser would keep choosing the missing
         file over the src just set. -->
    {uploaded ? (
      <Image
        src={uploaded}
        alt={thumbnailAlt ?? ''}
        widths={[400, 800, 1200]}
        sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
      />
    ) : (
      <img
        src={thumbs.primary}
        srcset={`${thumbs.fallback} 480w, ${thumbs.primary} 1280w`}
        sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
        data-fallback={thumbs.fallback}
        onerror={`this.onerror=null;this.srcset='';this.src='${thumbs.fallback}';`}
        alt=""
        width="1280"
        height="720"
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
      />
    )}

    <span class="absolute inset-0 flex items-center justify-center">
      <span
        class="flex h-16 w-16 items-center justify-center rounded-full bg-ted-red text-ink shadow-lg transition-transform duration-200 group-hover:scale-110"
        aria-hidden="true"
      >
        <svg viewBox="0 0 24 24" class="h-7 w-7 translate-x-[2px] fill-current"><path d="M8 5v14l11-7z" /></svg>
      </span>
    </span>

    <span class="sr-only">Play the talk “{title}” by {speaker}</span>
  </button>

  <div class="flex flex-1 flex-col gap-2 p-4">
    <h3 class="text-lg font-bold leading-snug">{title}</h3>
    <p class="text-sm font-semibold uppercase tracking-wide text-muted">{speaker}</p>
    {summary && <p class="text-sm text-muted">{summary}</p>}
    <p class="mt-auto pt-2 text-xs uppercase tracking-wide text-muted">
      {editionTitle ?? year}
    </p>
  </div>
</article>
