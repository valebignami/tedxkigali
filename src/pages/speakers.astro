---
import { getCollection, render } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import SpeakerCard from '~/components/SpeakerCard.astro';
import { compareOrder } from '~/lib/order';
import { speakerTalkLink } from '~/lib/speaker-talk';

const speakers = (await getCollection('speakers', ({ data }) => !data.draft)).sort((a, b) => {
  const byOrder = compareOrder(a.data.order, b.data.order);
  return byOrder !== 0 ? byOrder : a.data.name.localeCompare(b.data.name);
});

// Every talk, hidden ones included, looked up by hand rather than through
// getEntry: getEntry logs "Entry talks → … was not found" of its own accord,
// which lands in the failed-build email above the sentence written for the
// volunteer and says the same thing in the vocabulary the message exists to
// keep out. The draft flag has to travel with the talk either way, because a
// hidden talk and a deleted one need opposite answers.
const talksById = new Map((await getCollection('talks')).map((talk) => [talk.id, talk]));

const rendered = await Promise.all(
  speakers.map(async (speaker) => {
    const stored = speaker.data.talk;
    const found = stored ? talksById.get(stored) : undefined;
    const { href: talkHref } = speakerTalkLink(
      speaker.data.name,
      stored,
      found && { id: found.id, draft: found.data.draft },
    );
    const { Content } = await render(speaker);
    return { speaker, Content, talkHref };
  }),
);
---

<BaseLayout title="Speakers" description="The people who have taken the TEDxKigali stage.">
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h1 class="text-4xl font-black uppercase md:text-6xl">Speakers</h1>

    {rendered.length === 0 ? (
      <p class="mt-8 text-muted">Speaker profiles are on their way.</p>
    ) : (
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {rendered.map(({ speaker, Content, talkHref }) => (
          <SpeakerCard speaker={speaker} talkHref={talkHref}>
            <Content />
          </SpeakerCard>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
