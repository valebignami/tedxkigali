---
import { siteSettings } from '~/lib/settings';
import { internalHref } from '~/lib/base-path';
const year = new Date().getFullYear();
---

<!-- No top margin: BaseLayout makes <main> flex-1 inside a min-h-screen
     column, so on a page with little content the footer is already pushed to
     the bottom of the window and a margin only widens the empty band above
     it. On a page taller than the window the section's own bottom padding
     provides the separation. -->
<footer class="border-t border-line bg-surface">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 md:grid-cols-3">
    <div>
      <p class="text-xl font-black">
        <span class="text-ted-red">TED</span>xKigali
      </p>
      <p class="mt-2 text-sm text-muted">{siteSettings.tedxXExplanation}</p>
    </div>

    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wide">Contact</h2>
      <p class="mt-2 text-sm">
        <a class="inline-block py-1 underline hover:no-underline" href={`mailto:${siteSettings.contactEmail}`}>
          {siteSettings.contactEmail}
        </a>
      </p>
      <!-- py-1 on these links, and on the two above and below, lifts them from a
           17px line box to 25px, which clears the 24px floor WCAG 2.5.8 sets
           for a tap target. That is the height only. The shortest social label
           here is "X" — one character, which the mobile audit measured at about
           10px wide — and no amount of vertical padding widens it, so the width
           conforms through 2.5.8's spacing exception instead: gap-4 puts 16px
           between two links, so two 10px-wide ones have their centres 26px
           apart and their 24px circles clear each other by 2px. That margin is
           the reason to leave the gap alone; anything tighter than gap-4 here
           stops conforming. -->
      <ul class="mt-3 flex flex-wrap gap-4 text-sm">
        {siteSettings.socials.map((social) => (
          <li>
            <a class="inline-block py-1 underline hover:no-underline" href={social.url} rel="noopener noreferrer" target="_blank">
              {social.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="text-sm text-muted">
      <p>{siteSettings.tedxLicenceNotice}</p>
      <p class="mt-3">
        <a class="inline-block py-1 underline hover:no-underline" href={internalHref('/privacy')}>Privacy</a>
      </p>
      <p class="mt-3">© {year} TEDxKigali</p>
    </div>
  </div>
</footer>
