---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { eventEnd, eventState, isBookable, ticketStatusLine } from '~/lib/events';
import { resolveUploadedImage } from '~/lib/images';
import { formatEventDate } from '~/lib/dates';
import { internalHref } from '~/lib/base-path';

interface Props {
  event: CollectionEntry<'events'>;
  now?: Date;
  /**
   * The level of the card's own title. Three wherever a row of cards sits
   * straight under an h2 — "Upcoming", "Next event" — and four inside the
   * archive once it is split by programme, because the programme name is then
   * an h3 above it. Getting this wrong shows up nowhere on the screen and
   * plainly to anyone moving through the page by heading: the group and the
   * things inside it would rank the same.
   */
  headingLevel?: 3 | 4;
}

const { event, now = new Date(), headingLevel = 3 } = Astro.props;
// Capitalised so it is rendered as the tag name rather than as an element
// called "heading".
const Heading = `h${headingLevel}` as 'h3' | 'h4';
const data = event.data;
const ticketStatus = data.ticketStatus;

const state = eventState(data.startDate, data.endDate, now);
const bookable = isBookable(state, ticketStatus) && !!data.bookingUrl;
const image = data.image ? resolveUploadedImage(data.image) : null;

const dateLabel = formatEventDate(data.startDate);
---

<article
  class="flex flex-col overflow-hidden rounded-lg border border-line bg-surface"
  data-event
  data-event-state={state}
  data-programme={data.programme}
  data-event-start={data.startDate.toISOString()}
  data-event-end={eventEnd(data.startDate, data.endDate).toISOString()}
  data-ticket-status={ticketStatus}
>
  {image && (
    <Image
      src={image}
      alt={data.imageAlt ?? ''}
      widths={[400, 800, 1200]}
      sizes="(min-width: 1024px) 500px, 100vw"
      class="aspect-video w-full object-cover"
    />
  )}

  <div class="flex flex-1 flex-col gap-3 p-5">
    <p data-live-badge hidden class="w-fit rounded bg-ted-red px-2 py-1 text-xs font-bold uppercase text-ink">
      Happening now
    </p>

    <Heading data-event-title class="text-2xl font-bold leading-tight">
      <a class="hover:underline" href={internalHref(`/events/${event.id}`)}>{data.title}</a>
    </Heading>

    <p class="text-sm uppercase tracking-wide text-muted">
      <time datetime={data.startDate.toISOString()}>{dateLabel}</time> · {data.venue}
    </p>

    <p class="text-sm text-muted">{data.summary}</p>

    <p data-ticket-status-label class="text-sm font-semibold">{ticketStatusLine(state, ticketStatus)}</p>

    <div class="mt-auto flex flex-wrap gap-3 pt-2">
      {bookable && (
        <a
          data-booking
          href={data.bookingUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded bg-ted-red px-5 py-3 text-sm font-bold uppercase tracking-wide text-ink hover:bg-ted-red/90"
        >
          {data.bookingLabel}
        </a>
      )}
      <a
        href={internalHref(`/events/${event.id}`)}
        class="rounded border border-line px-5 py-3 text-sm font-bold uppercase tracking-wide hover:bg-bg"
      >
        Event details
      </a>
    </div>
  </div>
</article>
