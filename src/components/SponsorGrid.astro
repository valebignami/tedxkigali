---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { resolveUploadedImage } from '~/lib/images';
import { SPONSOR_TIERS, SPONSOR_TIER_LABELS, type SponsorTier } from '~/lib/sponsors';
import { compareOrder } from '~/lib/order';

interface Props {
  tierOrder?: readonly SponsorTier[];
  /** h2 on /partners, where the tiers are the page's sections; h3 on the home
      page strip, which already has a "Partners" h2 of its own. */
  headingLevel?: 2 | 3;
}

const { tierOrder = SPONSOR_TIERS, headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';

const sponsors = await getCollection('sponsors', ({ data }) => !data.draft);

const groups = tierOrder
  .map((tier) => ({
    tier,
    label: SPONSOR_TIER_LABELS[tier],
    items: sponsors
      .filter((sponsor) => sponsor.data.tier === tier)
      .sort((a, b) => compareOrder(a.data.order, b.data.order)),
  }))
  .filter((group) => group.items.length > 0);
---

{groups.length === 0 ? (
  <p class="mt-8 text-muted">Partner logos will appear here soon.</p>
) : (
  groups.map((group) => (
    <section class="mt-10">
      <Heading class="text-sm font-bold uppercase tracking-widest text-muted">{group.label}</Heading>
      <ul class="mt-4 flex flex-wrap items-center gap-8">
        {group.items.map((sponsor) => {
          const logo = resolveUploadedImage(sponsor.data.logo);
          const img = (
            <Image
              src={logo}
              alt={sponsor.data.logoAlt}
              widths={[200, 400]}
              sizes="200px"
              class="h-12 w-auto object-contain"
            />
          );
          return (
            <li>
              {sponsor.data.url ? (
                <a href={sponsor.data.url} target="_blank" rel="noopener noreferrer">{img}</a>
              ) : (
                img
              )}
            </li>
          );
        })}
      </ul>
    </section>
  ))
)}
